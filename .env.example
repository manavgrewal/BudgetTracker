# Optional. If left blank, the app generates one itself at DATA_DIR/secret.key on first boot
# and reuses it from then on. Set your own only if you want to manage it yourself. Generate
# with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Losing/rotating this makes every stored TOTP secret undecryptable; users must re-enroll MFA.
SECRET_KEY=

# Set to 1 only when behind a TLS-terminating reverse proxy you control.
# When on, X-Forwarded-Proto drives the Secure cookie flag and X-Forwarded-For drives rate-limit keys.
TRUST_PROXY=0

TZ=America/Toronto
PORT=3000
DATA_DIR=/data

# Optional, and only for the prebuilt-image install. install/synology-compose-pull.yml sets
# these two for you; a build-from-source install does not need them and leaves them unset.
# WATCHTOWER_URL points at the Watchtower companion on the compose network - the app refuses
# to send this request to anything that is not a bare service name, localhost, or a private
# IP literal - and WATCHTOWER_TOKEN must match WATCHTOWER_HTTP_API_TOKEN in that same file.
# WATCHTOWER_URL=http://watchtower:8080/v1/update
# WATCHTOWER_TOKEN=budget-tracker-local-update

# Optional escape hatch (v1.5.0). Absent by default, in which case the hardware probe (and its
# cache, settings.ocr.engine) decides which receipt reader runs. Set this to force one engine
# regardless of that probe or its cache -- this is the fix when the fast reader is armed but
# every receipt fails to read (a model mismatch, a resize failure, a shape-guard rejection):
# set it, restart, and OCR works again immediately, without waiting on or fighting a re-probe
# that would just answer the same way again. Accepted values are exactly "tesseract" (the
# older, slower, reliable reader) or "onnx" (the fast reader this app defaults to) -- anything
# else refuses to start rather than being silently ignored. See INSTALL.md's OCR section.
# OCR_ENGINE=tesseract
