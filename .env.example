# Optional. If left blank, the app generates one itself at DATA_DIR/secret.key on first boot
# and reuses it from then on. Set your own only if you want to manage it yourself. Generate
# with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Losing/rotating this makes every stored TOTP secret undecryptable; users must re-enroll MFA.
SECRET_KEY=

# Set to 1 only when behind a TLS-terminating reverse proxy you control.
# When on, X-Forwarded-Proto drives the Secure cookie flag and X-Forwarded-For drives rate-limit keys.
TRUST_PROXY=0

TZ=America/Toronto
PORT=3000
DATA_DIR=/data
