{
  "name": "budget-tracker",
  "version": "1.5.1",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fixtures": "node scripts/make-fixtures.mjs",
    "fetch-tessdata": "node scripts/fetch-tessdata.mjs",
    "fetch-ocr-models": "node scripts/fetch-ocr-models.mjs",
    "ocr-probe": "node scripts/ocr-probe.mjs",
    "vendor-scanner-assets": "node scripts/vendor-scanner-assets.mjs",
    "check-ocr-assets": "node scripts/check-ocr-assets.mjs",
    "reset-password": "node --experimental-strip-types scripts/reset-admin-password.ts",
    "restore-backup": "node --experimental-strip-types scripts/restore-backup.ts",
    "install:linux": "bash install/install-linux.sh"
  },
  "//ocr-pins": "onnxruntime-node is exact because the ARM instruction-set risk the runtime probe exists for is a property of one ORT build; a silent minor bump changes the MLAS kernels this release was probed against. jscanify is exact because it is pinned against one OpenCV.js API generation. @techstark/opencv-js is exact and must be 4.7.0-release.1; the 5.0.x builds from the same publisher change enough API surface that pairing them with jscanify 1.4.3 is untested. sharp takes a caret: per-platform optional deps, mature, and 0.34.5 was already present only as a transitive of Next.",
  "dependencies": {
    "@techstark/opencv-js": "4.7.0-release.1",
    "argon2": "^0.41.1",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.44.0",
    "iconv-lite": "^0.6.3",
    "jscanify": "1.4.3",
    "next": "^15.0.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.5",
    "onnxruntime-node": "1.27.0",
    "otplib": "^12.0.1",
    "papaparse": "^5.4.1",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "sharp": "^0.35.3",
    "tar": "^7.5.22",
    "tesseract.js": "^6.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.3.14",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
